import java.util.Locale;
import java.util.Scanner;    
public class Prg {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // ---------- ENTRADA ----------
        System.out.println("===== DATOS DEL CLIENTE =====");
        System.out.print("Ingrese el nombre del cliente: ");
        String nombre = sc.nextLine();

        System.out.print("Ingrese la cantidad de unidades: ");
        double cantidad = sc.nextDouble();

        System.out.print("Ingrese el precio unitario: ");
        double precioUnitario = sc.nextDouble();

        // ---------- PROCESO ----------
        double subtotal = cantidad * precioUnitario;
        double descuento = subtotal * 0.10; // descuento didáctico del 10%
        double total = subtotal - descuento;

        // ---------- SALIDA (resumen) ----------
        System.out.println("\n===== RESUMEN DE COMPRA =====");
        System.out.println("Cliente: " + nombre);
        System.out.printf(Locale.US, "Subtotal: %.2f%n", subtotal);
        System.out.printf(Locale.US, "Descuento (10%%): %.2f%n", descuento);
        System.out.printf(Locale.US, "Total a pagar: j%.2f%n", total);

        System.out.print("\nIngrese el monto con el que paga: ");
        double pago = sc.nextDouble();

        // ---------- COMPROBACIÓN DEL PAGO ----------
        if (pago >= total) {
            double cambio = pago - total;
            System.out.println("\nPago aceptado.");
            System.out.printf(Locale.US, "Su cambio es: %.2f%n", cambio);
        } else {
            double falta = total - pago;
            System.out.println("\nDinero insuficiente.");
            System.out.printf(Locale.US, "Le falta: %.2f%n", falta);
        }
        
        sc.close();
    }
}

